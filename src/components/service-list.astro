---
import ServiceItem from "@components/service-item.astro";
import { services } from "@data/services";
---

<nav
  class="flex flex-col border border-dotted border-zinc-800 divide-y divide-dotted divide-zinc-800 bg-[#000000]"
>
  {services.map((item) => (
    <ServiceItem {...item} />
  ))}
</nav>

<script>
  async function pingService(el: HTMLElement): Promise<void> {
    const targetUrl = el.dataset.url;
    if (!targetUrl) {
      return;
    }

    const start = performance.now();
    try {
      await fetch(targetUrl, {
        cache: "no-store",
        mode: "no-cors",
        signal: AbortSignal.timeout(3500),
      });
      const duration = Math.round(performance.now() - start);

      el.innerHTML = `
        <span class="text-[#4ade80]">[UP]</span>
        <span class="text-zinc-500 text-base">${duration}ms</span>
      `;
    } catch {
      el.innerHTML = `
        <span class="text-[#f87171]">[DOWN]</span>
      `;
    }
  }

  function checkPing(): void {
    const containers = Array.from(
      document.querySelectorAll<HTMLElement>(".service-status")
    );

    Promise.all(containers.map(pingService));
  }

  checkPing();
</script>
