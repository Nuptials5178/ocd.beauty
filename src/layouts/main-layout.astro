---
import Footer from "@components/footer.astro";
import Head from "@components/head.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body
    class="bg-[#000000] text-[#d4d4d8] select-none"
    style="font-family: 'Barrio', cursive, sans-serif;"
  >
    <slot />
    <Footer />
  </body>
</html>
